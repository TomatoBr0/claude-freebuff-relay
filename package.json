{
  "name": "claude-freebuff-relay",
  "version": "0.6.0",
  "description": "Claude Code plugin + CLI: hand off to Freebuff when you hit your Claude limit, sync its work back, and talk to Freebuff from Claude Code (fb).",
  "bin": {
    "claude-relay": "bin/claude-relay.js",
    "fb": "bin/fb.js",
    "claude-fb": "bin/claude-fb.js"
  },
  "main": "lib/core.js",
  "files": [
    "bin",
    "lib",
    "scripts",
    "hooks",
    "commands",
    ".claude-plugin",
    ".mcp.json"
  ],
  "scripts": {
    "test": "node test/run.js && node test/gateway.js"
  },
  "engines": {
    "node": ">=18"
  },
  "author": "Caleb",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomatoBr0/claude-freebuff-relay.git"
  },
  "dependencies": {
    "@xterm/headless": "6.0.0"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.18"
  }
}
